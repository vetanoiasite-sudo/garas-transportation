# SQL Server connection (Prisma). Adjust to your instance.
# Example (local SQL Server with SQL auth):
DATABASE_URL="sqlserver://localhost:1433;database=GarasTransportation;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# Server
PORT=8888

# Auth (replicates the old CompanyName + UserToken scheme)
# Comma-separated list of accepted CompanyName header values (single-tenant: one DB, validated names).
ALLOWED_COMPANIES="pharma,garas,demo"
# AES key/iv used to encrypt the session id into the UserToken (keep secret in real deployments).
TOKEN_SECRET="change-me-32-characters-long-secret"
# Session lifetime in hours (old scheme: 24h).
SESSION_HOURS=24
